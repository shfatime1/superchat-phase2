# Optional local convenience only. Render uses Environment Variables directly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
SUPERCHAT_ROUTING_MODE=auto
SUPERCHAT_DATA_MODE=providers
TRAVELPAYOUTS_API_TOKEN=
FLIGHT_CURRENCY=AZN
FLIGHT_MARKET=
# Optional TMDB application API Read Access Token (Bearer token).
TMDB_READ_ACCESS_TOKEN=
CINEMA_PROVIDER=auto
# auto / buywhere: public real-product search with no key; ebay is opt-in.
SHOPPING_PROVIDER=auto
# Optional BuyWhere key for authenticated detail refresh / higher quotas.
BUYWHERE_API_KEY=
# Catalog market only; never a delivery promise to Azerbaijan.
BUYWHERE_MARKET=US
# Prefer application credentials for automatic expiry renewal.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Alternatively supply a pre-generated, short-lived token.
EBAY_ACCESS_TOKEN=
EBAY_MARKETPLACE=EBAY_US
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_CONNECT_TIMEOUT_SECONDS=3
PROVIDER_REQUEST_BUDGET_SECONDS=12
PROVIDER_DOMAIN_BUDGET_SECONDS=20
PROVIDER_RETRIES=2
PROVIDER_CACHE_TTL=1800
CHAT_TIMEOUT_SECONDS=120
CHAT_RATE_LIMIT=30
GEMINI_TIMEOUT_MS=30000
GEMINI_RESPONSE_TIMEOUT_MS=4000
COOKIE_SECURE=false
PORT=8000
